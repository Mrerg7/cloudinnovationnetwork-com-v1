---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Market Journal | Premium Domain Insights | Cloud Innovation Network"
  description="Domain valuation guides, cloud market trends, and premium .com investing notes. cloudinnovationnetwork.com is for sale — secure escrow transfer."
  canonical="https://cloudinnovationnetwork.com/insights/"
>
  <Header />
  <main id="main" class="pt-28 pb-20 sm:pt-36">
    <div class="container-narrow">
      <p class="text-xs font-semibold uppercase tracking-wider text-cloud-400">
        <a href="/" class="hover:text-cloud-300">Home</a> <span aria-hidden="true">/</span> Journal
      </p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">Market Journal</h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-300">
        Valuation guides, cloud trends, and premium domain strategy. New notes published regularly.
      </p>

      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a href={`/insights/${post.slug}/`} class="card block p-6 transition hover:-translate-y-0.5">
            <p class="text-xs font-medium uppercase tracking-wider text-cloud-400">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </p>
            <h2 class="mt-2 text-xl font-semibold leading-snug text-white">{post.data.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-300">{post.data.description}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {post.data.tags.map((t) => (
                <span class="rounded-full border border-white/10 px-2.5 py-1 text-xs text-ink-400">{t}</span>
              ))}
            </div>
            <span class="mt-5 inline-block text-sm font-medium text-cloud-300">Read article →</span>
          </a>
        ))}
      </div>

      <div class="card mt-12 p-6 text-center sm:p-8">
        <h2 class="text-xl font-bold text-white">Like the authority this brand carries?</h2>
        <p class="mt-2 text-sm text-ink-300">cloudinnovationnetwork.com is available for acquisition via secure escrow.</p>
        <a href="mailto:sales@desertrich.com?subject=Domain%20Inquiry%20%E2%80%94%20cloudinnovationnetwork.com" class="btn-primary mt-5" data-cta="insights-index-offer">Make an Offer</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
