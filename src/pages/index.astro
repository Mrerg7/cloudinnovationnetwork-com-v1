---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const insights = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const stats = [
  { value: '$905B+', label: 'Global Cloud Market 2026', detail: 'Projected to exceed $1T this year' },
  { value: '94%+', label: 'Enterprise Adoption', detail: 'Organizations using cloud services' },
  { value: '21.3%', label: 'Public Cloud Growth', detail: 'Gartner forecast for 2026 spending' },
  { value: '$129B', label: 'Q1 2026 Infra Spend', detail: 'Record quarterly infrastructure revenue' },
];

const trends = [
  {
    title: 'AI-Native Infrastructure',
    description:
      'Hyperscalers are redirecting hundreds of billions into GPU clusters and specialized silicon. AI inference and training workloads now dominate new capacity planning across AWS, Azure, and Google Cloud.',
    icon: 'cpu',
  },
  {
    title: 'Hybrid & Multi-Cloud Maturity',
    description:
      'Enterprises treat public, private, and edge environments as a single fabric. Platform engineering, Kubernetes, and service mesh enable consistent policy and developer experience.',
    icon: 'layers',
  },
  {
    title: 'Edge & Distributed Compute',
    description:
      'Latency-sensitive apps and data-sovereignty push compute closer to users. Cloudflare, AWS Local Zones, Azure Edge Zones, and telecom partnerships expand cloud runtimes.',
    icon: 'globe',
  },
  {
    title: 'FinOps & Sustainable Cloud',
    description:
      'Cost visibility, waste reduction, and carbon-aware scheduling are first-class concerns. Teams measure unit economics while aligning infra with sustainability goals.',
    icon: 'leaf',
  },
];

const providers = [
  { name: 'AWS', share: '28–30%', note: 'Market leader by revenue' },
  { name: 'Microsoft Azure', share: '21–25%', note: 'Strong enterprise & AI growth' },
  { name: 'Google Cloud', share: '13–14%', note: 'Fastest major growth rate' },
];

const attributes = [
  { label: 'Extension', value: '.com', detail: 'Global standard for trust' },
  { label: 'Keywords', value: 'Cloud · Innovation · Network', detail: 'Exact-match category terms' },
  { label: 'Use cases', value: 'Media · Research · Consulting', detail: 'Events, education, community' },
  { label: 'Transfer', value: 'Secure escrow', detail: 'Auth-code push, 1–7 days' },
];

const steps = [
  { n: '01', title: 'Submit an offer', text: 'Email sales@desertrich.com with your offer, timeline, and intended use. Confidential, no obligation.' },
  { n: '02', title: 'Agree & escrow', text: 'We agree on price and terms, then open a licensed escrow transaction (Escrow.com, Dan, or Afternic compatible).' },
  { n: '03', title: 'Transfer & release', text: 'Domain is pushed via auth-code, you confirm control, escrow releases funds. Full ownership transfer.' },
];

const faqs = [
  {
    q: 'Is cloudinnovationnetwork.com really for sale?',
    a: 'Yes. This is an exclusive single-owner listing. The domain is available for acquisition by a serious buyer and transfers with full ownership.',
  },
  {
    q: 'What is the price?',
    a: 'Priced on application. Submit an offer or request pricing via sales@desertrich.com with your timeline and intended use. Tiered options (buy now vs. payment plan) can be discussed for qualified buyers.',
  },
  {
    q: 'How does the transfer work?',
    a: 'We use a licensed escrow service (Escrow.com, Dan.com, or Afternic compatible). After agreement, the domain is pushed via auth-code to your registrar. Funds are released only after you confirm control — typically 1–7 days.',
  },
  {
    q: 'What can I build on this domain?',
    a: 'A cloud media brand, analyst / research platform, consulting practice, events or education business, dev community, or AI-infrastructure startup. The keywords “cloud + innovation + network” give instant category authority.',
  },
  {
    q: 'Why a .com for a cloud brand?',
    a: 'Buyers trust .com for premium domain names: higher recall, better email deliverability, stronger resale value, and global recognition versus newer TLDs.',
  },
  {
    q: 'How fast can we close?',
    a: 'Most escrow transfers close in 1–7 days depending on registrars. Email sales@desertrich.com with subject “Domain Inquiry — cloudinnovationnetwork.com” for fastest response.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const offerMail = 'mailto:sales@desertrich.com?subject=Offer%20%E2%80%94%20cloudinnovationnetwork.com&body=Hi%2C%20I%27d%20like%20to%20offer%20%24_____%20for%20cloudinnovationnetwork.com.%20Timeline%3A%20_____.%20Intended%20use%3A%20_____.';
const buyMail = 'mailto:sales@desertrich.com?subject=Buy%20Now%20%E2%80%94%20cloudinnovationnetwork.com&body=Hi%2C%20I%20want%20to%20acquire%20cloudinnovationnetwork.com%20via%20secure%20escrow.%20Please%20send%20pricing%20and%20next%20steps.';
const agentMail = 'mailto:sales@desertrich.com?subject=Domain%20Inquiry%20%E2%80%94%20cloudinnovationnetwork.com';
---

<Layout>
  <Header />

  <main id="main">
    <!-- SALE HERO: minimal, domain-first -->
    <section id="sale" class="relative overflow-hidden pt-28 pb-12 sm:pt-36 sm:pb-16 lg:pt-40 lg:pb-20">
      <div class="pointer-events-none absolute inset-0 bg-hero-glow" aria-hidden="true"></div>

      <div class="container-narrow relative">
        <div class="mx-auto max-w-3xl text-center">
          <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-emerald-300">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
            </span>
            Premium .com · For Sale
          </p>

          <h1 class="mx-auto max-w-5xl text-balance text-[clamp(1.9rem,6.5vw,4.5rem)] font-extrabold leading-[1.05] tracking-tight text-white">
            cloud<wbr />innovation<wbr />network<span class="whitespace-nowrap bg-gradient-to-r from-cloud-300 via-cloud-400 to-sky-300 bg-clip-text text-transparent">.com</span>
          </h1>

          <p class="mx-auto mt-5 max-w-xl text-lg text-ink-300">
            A premium domain for cloud, AI infrastructure &amp; enterprise tech.
          </p>

          <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href={offerMail} class="btn-primary w-full sm:w-auto text-base !px-8 !py-3.5" data-cta="hero-make-offer">
              Make an Offer
            </a>
            <a href={buyMail} class="btn-secondary w-full sm:w-auto text-base !px-8 !py-3.5" data-cta="hero-buy-now">
              Buy Now via Escrow
            </a>
          </div>

          <p class="mt-6 text-xs text-ink-500">
            Secure escrow transfer · Priced on application · <a href={agentMail} class="text-ink-300 underline underline-offset-4 hover:text-white" data-cta="hero-contact-agent">Contact agent</a>
          </p>
        </div>
      </div>
    </section>

    <!-- At a glance: domain attributes (below the fold) -->
    <section aria-label="Domain details" class="border-t border-white/5">
      <div class="container-narrow py-10 sm:py-12">
        <dl class="grid grid-cols-2 gap-3 text-left lg:grid-cols-4">
          {attributes.map((a) => (
            <div class="card p-4 sm:p-5">
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-400">{a.label}</dt>
              <dd class="mt-1 text-sm font-bold text-white sm:text-base">{a.value}</dd>
              <dd class="mt-0.5 text-xs text-ink-400">{a.detail}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Escrow / marketplace strip -->
    <section aria-label="Accepted transaction methods" class="border-y border-white/5 bg-white/[0.02]">
      <div class="container-narrow flex flex-col items-center justify-between gap-3 py-5 text-center sm:flex-row sm:text-left">
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-400">
          Safe closing via licensed escrow
        </p>
        <ul class="flex flex-wrap items-center justify-center gap-2 text-xs font-medium text-ink-300">
          <li class="rounded-full border border-white/10 px-3 py-1.5">Escrow.com compatible</li>
          <li class="rounded-full border border-white/10 px-3 py-1.5">Dan.com compatible</li>
          <li class="rounded-full border border-white/10 px-3 py-1.5">Afternic compatible</li>
        </ul>
      </div>
    </section>

    <!-- Market Snapshot -->
    <section id="insights" class="section-padding border-t border-white/5 bg-ink-900/40">
      <div class="container-narrow">
        <div class="mx-auto max-w-2xl text-center reveal">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Why “cloud innovation” matters in 2026
          </h2>
          <p class="mt-4 text-ink-300">
            The cloud market keeps expanding on AI, enterprise modernization, and global digital transformation — exactly the authority this domain conveys.
          </p>
        </div>

        <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {stats.map((stat) => (
            <div class="card reveal p-6 text-center">
              <p class="text-3xl font-bold tracking-tight text-cloud-400 sm:text-4xl">{stat.value}</p>
              <p class="mt-2 text-sm font-semibold text-white">{stat.label}</p>
              <p class="mt-1 text-xs text-ink-400">{stat.detail}</p>
            </div>
          ))}
        </div>

        <div class="mt-12 rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8 reveal">
          <h3 class="text-center text-sm font-semibold uppercase tracking-wider text-ink-400">
            Approximate Market Share · Cloud Infrastructure (Q1 2026)
          </h3>
          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            {providers.map((p) => (
              <div class="text-center">
                <p class="text-2xl font-bold text-white">{p.share}</p>
                <p class="mt-1 font-medium text-cloud-300">{p.name}</p>
                <p class="mt-0.5 text-xs text-ink-500">{p.note}</p>
              </div>
            ))}
          </div>
          <p class="mt-6 text-center text-xs text-ink-500">
            Sources: Synergy Research Group, Gartner, Fortune Business Insights, industry reports (2026). Figures are approximate and vary by methodology. <a href="/insights/" class="text-cloud-400 hover:text-cloud-300 underline underline-offset-2">Read our market journal →</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Trends -->
    <section id="trends" class="section-padding">
      <div class="container-narrow">
        <div class="mx-auto max-w-2xl text-center reveal">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Defining Trends
          </h2>
          <p class="mt-4 text-ink-300">
            Four forces reshaping cloud platforms — and the content verticals a buyer can own with this brand.
          </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2">
          {trends.map((trend) => (
            <article class="card reveal p-6 sm:p-8">
              <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-cloud-500/15 text-cloud-400" aria-hidden="true">
                {trend.icon === 'cpu' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z" /></svg>
                )}
                {trend.icon === 'layers' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L2.25 12l4.179 2.25M12 14.25l5.571-3m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l4.179 2.25L12 21.75" /></svg>
                )}
                {trend.icon === 'globe' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>
                )}
                {trend.icon === 'leaf' && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" /></svg>
                )}
              </div>
              <h3 class="text-xl font-semibold text-white">{trend.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-300">{trend.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Opportunity -->
    <section id="opportunity" class="section-padding border-t border-white/5 bg-gradient-to-b from-cloud-950/30 to-ink-950">
      <div class="container-narrow">
        <div class="mx-auto max-w-3xl text-center reveal">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            A Category-Defining Digital Asset
          </h2>
          <p class="mt-5 text-lg text-ink-300">
            <strong class="text-white">cloudinnovationnetwork.com</strong> sits at the intersection of one of the largest tech markets on earth. Build a media brand, analyst platform, consulting practice, or community on instant authority.
          </p>
          <ul class="mt-10 space-y-4 text-left text-ink-300">
            <li class="flex gap-3">
              <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-cloud-500/20 text-cloud-400" aria-hidden="true"><svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg></span>
              <span>Exact-match brand for cloud innovation, research, and thought leadership</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-cloud-500/20 text-cloud-400" aria-hidden="true"><svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg></span>
              <span>Ideal for media, events, education, consulting, or platform initiatives</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-cloud-500/20 text-cloud-400" aria-hidden="true"><svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg></span>
              <span>Clean, memorable, and globally relevant across English-speaking markets</span>
            </li>
          </ul>
          <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href={offerMail} class="btn-primary text-base !px-8 !py-3.5 w-full sm:w-auto" data-cta="opportunity-offer">Make an Offer</a>
            <a href={agentMail} class="btn-secondary w-full sm:w-auto" data-cta="opportunity-pricing">Request Pricing &amp; Terms</a>
          </div>
        </div>

        <!-- Brand visualization (reuses hero artwork, lazy-loaded below the fold) -->
        <figure class="reveal mx-auto mt-14 max-w-4xl">
          <div class="overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-cloud-950/50">
            <img
              src="https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/6f43edc0-9506-49fb-8bd2-0add1b876a00/public"
              alt="Visualization of the cloudinnovationnetwork.com brand displayed as office signage"
              class="aspect-video w-full object-cover"
              loading="lazy"
              decoding="async"
              width="1280"
              height="720"
            />
          </div>
          <figcaption class="mt-3 text-center text-xs text-ink-500">
            Visualize your brand here — the domain carries instant category authority for cloud and AI infrastructure.
          </figcaption>
        </figure>

        <!-- How acquisition works -->
        <div class="mt-16 grid gap-5 md:grid-cols-3">
          {steps.map((s) => (
            <div class="card reveal p-6 sm:p-7">
              <p class="text-sm font-bold tracking-widest text-cloud-400">{s.n}</p>
              <h3 class="mt-2 text-lg font-semibold text-white">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-300">{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Journal preview (internal linking for SEO/DA) -->
    <section class="section-padding border-t border-white/5" aria-labelledby="journal-heading">
      <div class="container-narrow">
        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
          <div class="reveal">
            <h2 id="journal-heading" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Market Journal</h2>
            <p class="mt-3 max-w-xl text-ink-300">Valuation guides, market trends, and domain-investing notes — updated regularly.</p>
          </div>
          <a href="/insights/" class="btn-secondary shrink-0" data-cta="journal-view-all">View all insights →</a>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {insights.map((post) => (
            <a href={`/insights/${post.slug}/`} class="card reveal block p-6 transition hover:-translate-y-0.5" data-cta="journal-card">
              <p class="text-xs font-medium uppercase tracking-wider text-cloud-400">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </p>
              <h3 class="mt-2 text-lg font-semibold leading-snug text-white">{post.data.title}</h3>
              <p class="mt-2 line-clamp-3 text-sm text-ink-300">{post.data.description}</p>
              <span class="mt-4 inline-block text-sm font-medium text-cloud-300">Read article →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="section-padding border-t border-white/5 bg-ink-900/40" aria-labelledby="faq-heading">
      <div class="container-narrow">
        <div class="mx-auto max-w-3xl">
          <div class="text-center reveal">
            <h2 id="faq-heading" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Domain Sale FAQ</h2>
            <p class="mt-4 text-ink-300">Everything buyers ask before acquiring a premium domain name.</p>
          </div>
          <div class="mt-8 reveal">
            <label for="faq-search" class="sr-only">Search frequently asked questions</label>
            <input
              id="faq-search"
              type="search"
              placeholder="Search questions… (e.g. escrow, price, transfer)"
              autocomplete="off"
              class="w-full rounded-full border border-white/15 bg-white/5 px-5 py-3.5 text-base text-white placeholder:text-ink-500 focus:border-cloud-400/60 focus:outline-none"
            />
          </div>
          <div id="faq-list" class="mt-6 space-y-3">
            {faqs.map((f, i) => (
              <div class="faq-item card overflow-hidden" data-open={i === 0 ? 'true' : 'false'} data-question={f.q.toLowerCase()}>
                <button
                  type="button"
                  class="faq-toggle flex min-h-[56px] w-full items-center justify-between gap-4 px-5 py-4 text-left sm:px-6"
                  aria-expanded={i === 0 ? 'true' : 'false'}
                >
                  <span class="text-sm font-semibold text-white sm:text-base">{f.q}</span>
                  <span class="faq-chevron shrink-0 text-cloud-400" aria-hidden="true">＋</span>
                </button>
                <div class="faq-answer" role="region">
                  <div>
                    <p class="px-5 pb-5 text-sm leading-relaxed text-ink-300 sm:px-6">{f.a}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <p id="faq-empty" class="mt-4 hidden text-center text-sm text-ink-400">No questions match your search. <a href={agentMail} class="text-cloud-300 underline underline-offset-2">Ask us directly →</a></p>
          <div class="mt-10 text-center reveal">
            <a href={offerMail} class="btn-primary text-base !px-8 !py-3.5" data-cta="faq-offer">Start with an Offer</a>
          </div>
        </div>
      </div>
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    </section>
  </main>

  <!-- Sticky mobile buy bar -->
  <div id="sticky-cta" class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-white/10 bg-ink-950/95 px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 backdrop-blur-xl transition-transform duration-300 sm:hidden">
    <div class="flex gap-2">
      <a href={offerMail} class="btn-primary flex-1 text-sm" data-cta="sticky-offer">Make Offer</a>
      <a href={buyMail} class="btn-secondary flex-1 text-sm" data-cta="sticky-buy">Buy Now</a>
    </div>
  </div>

  <!-- Exit-intent / timed offer capture -->
  <div id="exit-modal" class="fixed inset-0 z-[60] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="exit-title">
    <div id="exit-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
    <div class="card relative w-full max-w-md p-6 !bg-ink-900 text-center sm:p-8">
      <button id="exit-close" type="button" class="absolute right-3 top-3 flex h-12 w-12 items-center justify-center rounded-lg text-ink-400 hover:text-white" aria-label="Close offer dialog">✕</button>
      <p class="text-xs font-semibold uppercase tracking-wider text-emerald-300">Before you go</p>
      <h2 id="exit-title" class="mt-2 text-2xl font-bold text-white">Get pricing &amp; terms first</h2>
      <p class="mt-3 text-sm text-ink-300">Email <span class="font-semibold text-white">sales@desertrich.com</span> with subject <span class="font-mono text-xs text-cloud-300">Domain Inquiry — cloudinnovationnetwork.com</span> and we’ll reply with pricing, escrow options, and transfer timeline.</p>
      <div class="mt-6 flex flex-col gap-2">
        <a href={agentMail} class="btn-primary w-full" data-cta="exit-contact">Request Pricing &amp; Terms</a>
        <button id="exit-dismiss" type="button" class="min-h-[48px] text-sm text-ink-400 hover:text-white">No thanks, I’m just browsing</button>
      </div>
    </div>
  </div>

  <Footer />

  <script>
    // Reveal on scroll
    const revealEls = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && revealEls.length) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('is-visible')),
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      revealEls.forEach((el) => io.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }

    // FAQ accordion + search
    document.querySelectorAll('.faq-item').forEach((item) => {
      const btn = item.querySelector('.faq-toggle');
      btn?.addEventListener('click', () => {
        const open = item.getAttribute('data-open') === 'true';
        document.querySelectorAll('.faq-item').forEach((o) => {
          o.setAttribute('data-open', 'false');
          o.querySelector('.faq-toggle')?.setAttribute('aria-expanded', 'false');
        });
        item.setAttribute('data-open', String(!open));
        btn.setAttribute('aria-expanded', String(!open));
      });
    });
    const search = document.getElementById('faq-search');
    const empty = document.getElementById('faq-empty');
    search?.addEventListener('input', (e) => {
      const q = (e.target.value || '').toLowerCase().trim();
      let visible = 0;
      document.querySelectorAll('.faq-item').forEach((item) => {
        const text = item.getAttribute('data-question') || '';
        const show = !q || text.includes(q);
        item.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      empty?.classList.toggle('hidden', visible !== 0);
    });

    // Sticky mobile CTA after scrolling past hero
    const sticky = document.getElementById('sticky-cta');
    const sale = document.getElementById('sale');
    const onScroll = () => {
      if (!sticky || !sale) return;
      const past = window.scrollY > sale.offsetHeight * 0.7;
      sticky.classList.toggle('translate-y-full', !past);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Exit-intent (desktop) + timed (mobile), once per 7 days
    const modal = document.getElementById('exit-modal');
    const KEY = 'cin-exit-seen';
    const seen = () => {
      try {
        const v = localStorage.getItem(KEY);
        return v && Date.now() - Number(v) < 7 * 24 * 3600 * 1000;
      } catch (e) {
        return true;
      }
    };
    const show = () => {
      if (!modal || seen()) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      try {
        localStorage.setItem(KEY, String(Date.now()));
      } catch (e) {}
    };
    const hide = () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    };
    document.getElementById('exit-close')?.addEventListener('click', hide);
    document.getElementById('exit-dismiss')?.addEventListener('click', hide);
    document.getElementById('exit-backdrop')?.addEventListener('click', hide);
    document.addEventListener('keydown', (e) => e.key === 'Escape' && hide());
    document.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget && e.clientY <= 0) show();
    });
    setTimeout(() => {
      if (window.innerWidth < 640) show();
    }, 45000);

    // Lightweight CTA tracking hook (swap with Plausible/CF analytics)
    document.querySelectorAll('[data-cta]').forEach((el) => {
      el.addEventListener('click', () => {
        const name = el.getAttribute('data-cta');
        if (window.plausible) window.plausible('CTA:' + name);
      });
    });
  </script>

  <style>
    .line-clamp-3 {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>
</Layout>
