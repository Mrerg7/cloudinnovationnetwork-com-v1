---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found | Cloud Innovation Network"
  description="The page you are looking for does not exist or has been moved."
  canonical="https://cloudinnovationnetwork.com/"
  noindex={true}
>
  <Header />
  <main class="flex flex-1 flex-col items-center justify-center px-4 py-32 text-center">
    <p class="text-sm font-medium uppercase tracking-widest text-cloud-400">404</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-5xl">Page not found</h1>
    <p class="mt-4 max-w-md text-ink-300">
      The page you’re looking for doesn’t exist or has been moved.
    </p>
    <a href="/" class="btn-primary mt-8">
      Back to home
    </a>
  </main>
  <Footer />
</Layout>
