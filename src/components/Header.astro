---
const navItems = [
  { href: '/#sale', label: 'Buy Domain' },
  { href: '/#insights', label: 'Insights' },
  { href: '/#trends', label: 'Trends' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/insights/', label: 'Journal' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 bg-ink-950/80 backdrop-blur-xl">
  <div class="container-narrow flex h-16 items-center justify-between sm:h-[72px]">
    <a href="/" class="group flex min-h-[48px] items-center gap-2.5" aria-label="Cloud Innovation Network home">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-cloud-400 to-cloud-600 shadow-lg shadow-cloud-500/20 transition group-hover:shadow-cloud-400/40">
        <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
        </svg>
      </div>
      <span class="text-sm font-semibold tracking-tight text-white sm:text-base">
        Cloud Innovation <span class="text-cloud-400">Network</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="flex min-h-[48px] items-center text-sm font-medium text-ink-300 transition hover:text-white"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        id="theme-toggle"
        type="button"
        class="flex h-12 w-12 items-center justify-center rounded-lg text-ink-300 transition hover:text-white"
        aria-label="Toggle light and dark mode"
        aria-pressed="false"
      >
        <svg id="theme-icon-moon" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0012 21.75a9.753 9.753 0 009.752-6.748z" />
        </svg>
        <svg id="theme-icon-sun" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
      </button>

      <a
        href="mailto:sales@desertrich.com?subject=Domain%20Inquiry%20%E2%80%94%20cloudinnovationnetwork.com"
        class="btn-primary text-xs sm:text-sm !px-4 !py-2 sm:!px-5 sm:!py-2.5"
        data-cta="header-acquire"
      >
        Acquire Domain
      </a>

      <button
        id="mobile-toggle"
        type="button"
        class="md:hidden flex items-center justify-center h-12 w-12 rounded-lg text-ink-300 hover:text-white transition"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="mobile-icon-open" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="mobile-icon-close" class="hidden h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-white/5 bg-ink-950/95 backdrop-blur-xl">
    <nav class="container-narrow flex flex-col gap-1 py-4" aria-label="Mobile">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="flex min-h-[48px] items-center rounded-lg px-4 py-3 text-base font-medium text-ink-300 transition hover:bg-white/5 hover:text-white"
        >
          {item.label}
        </a>
      ))}
      <a
        href="mailto:sales@desertrich.com?subject=Domain%20Acquisition%20Inquiry%20%E2%80%94%20cloudinnovationnetwork.com"
        class="btn-primary mt-2 w-full"
        data-cta="mobile-acquire"
      >
        Make an Offer
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('mobile-icon-open');
  const iconClose = document.getElementById('mobile-icon-close');

  if (toggle && menu && iconOpen && iconClose) {
    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', isOpen);
      iconOpen.classList.toggle('hidden', !isOpen);
      iconClose.classList.toggle('hidden', isOpen);
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });

    document.querySelectorAll('#mobile-menu a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Light / dark toggle (persisted, defaults to dark)
  const themeBtn = document.getElementById('theme-toggle');
  const iconMoon = document.getElementById('theme-icon-moon');
  const iconSun = document.getElementById('theme-icon-sun');
  const syncThemeUI = () => {
    const isLight = document.documentElement.classList.contains('light-mode');
    iconMoon?.classList.toggle('hidden', isLight);
    iconSun?.classList.toggle('hidden', !isLight);
    themeBtn?.setAttribute('aria-pressed', String(isLight));
  };
  syncThemeUI();
  themeBtn?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light-mode');
    try {
      localStorage.setItem('cin-theme', isLight ? 'light' : 'dark');
    } catch (e) {}
    syncThemeUI();
  });
</script>
