---
const year = new Date().getFullYear();
const agentMail = 'mailto:sales@desertrich.com?subject=Domain%20Acquisition%20Inquiry%20%E2%80%94%20cloudinnovationnetwork.com';
---

<footer class="relative mt-auto border-t border-white/10 bg-ink-950">
  <!-- Domain Acquisition CTA -->
  <div class="border-b border-white/5 bg-gradient-to-b from-cloud-950/40 to-transparent">
    <div class="container-narrow section-padding !py-16 sm:!py-20">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-cloud-500/30 bg-cloud-500/10 px-4 py-1.5 text-xs font-medium uppercase tracking-wider text-cloud-300">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cloud-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-cloud-400"></span>
          </span>
          Domain Available
        </div>

        <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl lg:text-4xl">
          This premium domain is available<br class="hidden sm:block" /> for acquisition
        </h2>

        <p class="mt-4 text-base text-ink-300 sm:text-lg">
          <span class="font-medium text-white">cloudinnovationnetwork.com</span> — a category-defining .com for cloud, AI infrastructure, and enterprise tech. Secure escrow. Priced on application.
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="mailto:sales@desertrich.com?subject=Offer%20%E2%80%94%20cloudinnovationnetwork.com"
            class="btn-primary w-full sm:w-auto"
            data-cta="footer-offer"
          >
            Make an Offer
          </a>
          <a
            href={agentMail}
            class="btn-secondary w-full sm:w-auto"
            data-cta="footer-pricing"
          >
            Request Pricing &amp; Terms
          </a>
        </div>

        <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-1 text-xs text-ink-400" aria-label="Assurances">
          <li>✓ Escrow-protected</li>
          <li>✓ Fast transfer</li>
          <li>✓ Confidential inquiries</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Main footer content -->
  <div class="container-narrow py-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href="/" class="flex min-h-[48px] items-center gap-2.5" aria-label="Cloud Innovation Network home">
          <div class="flex h-8 w-8 items-center justify-center rounded-md bg-gradient-to-br from-cloud-400 to-cloud-600">
            <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
            </svg>
          </div>
          <span class="text-sm font-semibold text-white">Cloud Innovation Network</span>
        </a>
        <p class="mt-3 max-w-sm text-sm text-ink-400">
          Exploring the architectures, platforms, and ideas that power the modern cloud era — and offering this premium domain for acquisition.
        </p>
        <p class="mt-4 text-sm text-ink-400">
          Domain inquiries:
          <a href="mailto:sales@desertrich.com" class="text-cloud-400 hover:text-cloud-300 transition">
            sales@desertrich.com
          </a>
        </p>
      </div>

      <nav aria-label="Site">
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">Site</p>
        <ul class="mt-3 space-y-1 text-sm">
          <li><a href="/#sale" class="inline-flex min-h-[40px] items-center text-ink-300 hover:text-white">Buy this domain</a></li>
          <li><a href="/#insights" class="inline-flex min-h-[40px] items-center text-ink-300 hover:text-white">Market snapshot</a></li>
          <li><a href="/#trends" class="inline-flex min-h-[40px] items-center text-ink-300 hover:text-white">Trends</a></li>
          <li><a href="/#faq" class="inline-flex min-h-[40px] items-center text-ink-300 hover:text-white">Sale FAQ</a></li>
          <li><a href="/insights/" class="inline-flex min-h-[40px] items-center text-ink-300 hover:text-white">Journal</a></li>
        </ul>
      </nav>

      <nav aria-label="Resources">
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">Resources</p>
        <ul class="mt-3 space-y-1 text-sm">
          <li><a href="/insights/" class="inline-flex min-h-[40px] items-center text-ink-300 hover:text-white">Domain valuation guides</a></li>
          <li><a href="/sitemap-index.xml" class="inline-flex min-h-[40px] items-center text-ink-300 hover:text-white">Sitemap</a></li>
          <li><a href="/robots.txt" class="inline-flex min-h-[40px] items-center text-ink-300 hover:text-white">Robots.txt</a></li>
          <li><a href={agentMail} class="inline-flex min-h-[40px] items-center text-ink-300 hover:text-white">Contact agent</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-3 border-t border-white/5 pt-6 text-sm text-ink-400 sm:flex-row sm:items-center">
      <p>© {year} Cloud Innovation Network</p>
      <p class="text-xs">Premium domain for sale · Secure escrow transfer</p>
    </div>

    <!-- Disclaimer -->
    <div class="mt-6 rounded-xl border border-white/5 bg-white/[0.02] p-5 sm:p-6">
      <p class="text-xs leading-relaxed text-ink-500">
        <strong class="font-medium text-ink-400">Disclaimer:</strong>
        This website is for demonstration and informational purposes only. It does not constitute an offer of services,
        a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and references to specific
        technologies are based on publicly available information as of July 2026 and are subject to change.
        Cloud Innovation Network is a brand and domain concept; no affiliation with any hyperscaler or cloud provider is implied or expressed.
      </p>
    </div>
  </div>
</footer>
