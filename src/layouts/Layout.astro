---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = 'Cloud Innovation Network | The Future of Cloud Computing',
  description = 'Cloud Innovation Network explores the evolving landscape of cloud computing, AI-driven infrastructure, hybrid architectures, and the technologies shaping the next decade of digital transformation.',
  ogImage = 'https://cloudinnovationnetwork.com/og-image.png',
  canonical = 'https://cloudinnovationnetwork.com/',
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://cloudinnovationnetwork.com/#website',
      url: 'https://cloudinnovationnetwork.com/',
      name: 'Cloud Innovation Network',
      description,
      publisher: {
        '@id': 'https://cloudinnovationnetwork.com/#organization',
      },
      inLanguage: 'en-US',
    },
    {
      '@type': 'Organization',
      '@id': 'https://cloudinnovationnetwork.com/#organization',
      name: 'Cloud Innovation Network',
      url: 'https://cloudinnovationnetwork.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://cloudinnovationnetwork.com/favicon.svg',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'sales@desertrich.com',
        contactType: 'sales',
        availableLanguage: 'English',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Cloud Innovation Network" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme & Icons -->
    <meta name="theme-color" content="#0c4a6e" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>
